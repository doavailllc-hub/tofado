EXPO_PUBLIC_API_URL=https://api.tofado.com/api
# Expo automatically loads this file after you copy it to .env.
# A physical phone must use the backend computer's LAN IP, not localhost.
EXPO_PUBLIC_MERCHANT_URL=https://merchant.tofado.com
# retailer = Tofado, wholesaler = Tofado Business
EXPO_PUBLIC_APP_VARIANT=retailer
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_RETAILER_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WHOLESALER_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
