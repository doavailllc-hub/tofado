{
  "name": "tofado-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:retailer": "expo run:android --variant retailerDebug --app-id com.tofado.app",
    "android:wholesaler": "expo run:android --variant wholesalerDebug --app-id com.tofado.business",
    "aab:retailer": "cd android && gradlew.bat bundleRetailerRelease",
    "aab:wholesaler": "cd android && gradlew.bat bundleWholesalerRelease",
    "aab:all": "cd android && gradlew.bat bundleRetailerRelease bundleWholesalerRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "axios": "^1.12.0",
    "expo": "~57.0.18",
    "expo-auth-session": "~57.0.10",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  }
}
