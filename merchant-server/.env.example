SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Tofado <no-reply@tofado.com>
CLIENT_URL=http://localhost:5173
NODE_ENV=development
