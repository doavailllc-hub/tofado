# Copy to .env. Generate a unique JWT secret; do not use this placeholder.
NODE_ENV=development
PORT=5000
JWT_SECRET=
CLIENT_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tofado_merchant
DB_USER=tofado_app
DB_PASSWORD=
# Optional: exact trusted reverse-proxy IPs/CIDRs, comma-separated.
# Do not set a blanket trust value on a publicly reachable API.
TRUST_PROXY=
AWS_REGION=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
GOOGLE_CLIENT_IDS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Only use an isolated demonstration account for app-store review.
PLAY_REVIEW_EMAIL=
PLAY_REVIEW_OTP=
PLAY_REVIEW_ROLE=
# Separate schema-management identity, used only by npm run db:migrate.
MIGRATION_DB_HOST=
MIGRATION_DB_PORT=3306
MIGRATION_DB_NAME=
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
