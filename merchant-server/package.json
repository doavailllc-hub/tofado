    "staging:prepare": "node scripts/staging-prepare.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^9.0.5"
