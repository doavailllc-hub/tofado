{
  "name": "tofado-merchant-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "db:check": "node scripts/check-schema.js",
    "finance:check": "node scripts/check-finance.js",
    "db:migrate": "node scripts/migrate.js",
    "schema:export": "node scripts/export-schema.js",
    "staging:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/staging-start.ps1",
    "staging:status": "node scripts/staging-status.js",
    "staging:stop": "node scripts/staging-stop.js",
    "staging:import": "node scripts/staging-import.js",
    "staging:check": "node scripts/staging-run.js check",
    "staging:finance": "node scripts/staging-run.js finance",
    "staging:test": "node scripts/staging-run.js test",
    "staging:migrate": "node scripts/staging-run.js migrate",
